    {
      "codigo": "Aporta",
      "expression": "Avao - 80",
      "scope": "VAO",
      "order_in_scope": 2
    }
  ],
  "piece_groups": [
    {
      "codigo": "PORTA",
      "label": "Folha da porta",
      "quantity_expression": "1",
      "ordem": 1,
      "piece_roles": [
        {
          "codigo": "UNICO",
          "label": "Porta",
          "selector_kind": "ALL",
          "width_expression": "Lporta - 10",
          "height_expression": "Aporta",
          "ordem": 1
        }
      ]
    },
    {
      "codigo": "FIXO",
      "label": "Fixo lateral",
      "quantity_expression": "1",
      "ordem": 2,
      "piece_roles": [
        {
          "codigo": "FIXO_U",
          "label": "Fixo (instalação U)",
          "selector_kind": "ALL",
          "condition": "TipoInstalacao == 'U'",
          "width_expression": "Lfixo_bruto - 2*Pu",
          "height_expression": "Avao - 2*Pu",
          "ordem": 1
        },
        {
          "codigo": "FIXO_FERRAGEM",
          "label": "Fixo (instalação ferragem)",
          "selector_kind": "ALL",
          "condition": "TipoInstalacao == 'FERRAGEM'",
          "width_expression": "Lfixo_bruto - 2*Pferragem",
          "height_expression": "Avao - 2*Pferragem",
          "ordem": 2
        }
      ]
    }
