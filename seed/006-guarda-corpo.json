{
  "nome": "Guarda-corpo",
  "descricao": "Peças orçadas peça a peça com furação por torre (caso 006).",
  "categoria_id": 5,
  "modoDeProducao": "MEDIDA_DE_PRODUCAO",
  "ordem": 30,
  "ativo": true,
  "vidros_elegiveis": [
    "INCOLOR_8", "INCOLOR_10", "INCOLOR_12",
    "FUME_10", "FUME_12",
    "VERDE_10", "VERDE_12"
  ],
  "variables": [
    {
      "codigo": "ModeloTorre",
      "label": "Modelo da torre",
      "kind": "OPTION_LIST",
      "nivel": "ORCAMENTO",
      "required": true,
      "default_value": "30",
      "options": [
        { "codigo": "20", "label": "Torre 20" },
        { "codigo": "30", "label": "Torre 30" },
        { "codigo": "40", "label": "Torre 40" }
      ],
      "ordem": 1
    },
    {
      "codigo": "Largura",
      "label": "Largura da peça",
      "kind": "DIMENSION",
      "nivel": "PECA",
      "unit": "mm",
      "required": true,
      "min_value": "300",
      "max_value": "3000",
      "ordem": 1
    },
    {
      "codigo": "Altura",
      "label": "Altura da peça",
      "kind": "DIMENSION",
      "nivel": "PECA",
      "unit": "mm",
      "required": true,
      "min_value": "300",
      "max_value": "2500",
      "ordem": 2
    },
    {
      "codigo": "QtdTorres",
      "label": "Torres",
      "kind": "COUNT",
      "nivel": "PECA",
      "unit": "un",
      "required": true,
      "min_value": "2",
      "max_value": "6",
      "default_value": "2",
      "ordem": 3
    },
    {
      "codigo": "FurosPorTorre",
      "label": "Furos por torre",
      "kind": "COUNT",
      "nivel": "PECA",
      "unit": "un",
      "required": true,
      "min_value": "1",
      "max_value": "3",
      "default_value": "1",
      "ordem": 4
    },
    {
      "codigo": "DistBordaH",
      "label": "Distância da borda (horizontal)",
      "kind": "DIMENSION",
      "nivel": "PECA",
      "unit": "mm",
      "required": false,
      "default_value": "80",
      "ordem": 5
    },
    {
      "codigo": "DistBordaV",
      "label": "Distância da borda (vertical)",
      "kind": "DIMENSION",
      "nivel": "PECA",
      "unit": "mm",
      "required": false,
      "default_value": "210",
      "ordem": 6
    }
  ],
  "computed_values": [
    {
      "codigo": "DistEntreTorres",
      "expression": "(Largura - 2 * DistBordaH) / (QtdTorres - 1)",
      "scope": "ORCAMENTO_PECA",
      "order_in_scope": 1
    }
  ],
  "specification_templates": [
    {
      "codigo": "FURACAO",
      "label": "Furação por torre",
      "schema_atributos": {
        "qtdTorres": { "type": "integer", "source": "QtdTorres" },
        "furosPorTorre": { "type": "integer", "source": "FurosPorTorre" },
        "distBordaH": { "type": "number", "source": "DistBordaH" },
        "distBordaV": { "type": "number", "source": "DistBordaV" },
        "distEntreTorres": { "type": "number", "source": "DistEntreTorres" }
      },
      "required_min": 1,
      "required_max": 1,
      "ordem": 1
    }
  ],
  "pricing_rules": [
    {
      "codigo": "VIDRO_M2",
      "label": "Vidro por m²",
      "component_kind": "VIDRO",
      "basis": "PER_M2",
      "applies_to": "TIPOLOGIA",
      "expression": "precoVidro(VidroId)",
      "ordem": 1,
      "ativo": true
    },
    {
      "codigo": "FURO",
      "label": "Furação por torre",
      "component_kind": "BENEFICIAMENTO",
      "basis": "PER_SPECIFICATION",
      "applies_to": "SPECIFICATION_TYPE",
      "applies_to_value": "FURACAO",
      "expression": "8 * qtdTorres * furosPorTorre",
      "ordem": 2,
      "ativo": true
    },
    {
      "codigo": "TORRE",
      "label": "Torres por peça",
      "component_kind": "FERRAGEM",
      "basis": "PER_PIECE",
      "applies_to": "TIPOLOGIA",
      "expression": "QtdTorres * precoTorre(ModeloTorre)",
      "ordem": 3,
      "ativo": true
    },
    {
      "codigo": "INSTALACAO",
      "label": "Instalação",
      "component_kind": "INSTALACAO",
      "basis": "PER_ORCAMENTO",
      "applies_to": "TIPOLOGIA",
      "expression": "200 + 50 * count(pecas)",
      "ordem": 4,
      "ativo": true
    }
  ]
}
